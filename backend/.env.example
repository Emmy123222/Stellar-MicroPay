PORT=4000
NODE_ENV=development

# JWT Secret for authentication (REQUIRED)
# Generate a strong random value with: openssl rand -base64 48
# NEVER use a default or weak value in production
JWT_SECRET=your_secure_random_secret_here

# Stellar Network: "testnet" | "mainnet"
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# JWT Secret for token signing (REQUIRED)
# Generate a strong random secret with: openssl rand -base64 48
JWT_SECRET=

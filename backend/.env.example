PORT=4000
NODE_ENV=development

# Stellar Network: "testnet" | "mainnet"
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Horizon circuit breaker: consecutive failures before the circuit opens
HORIZON_BREAKER_FAILURE_THRESHOLD=5
# Milliseconds the circuit stays open before a single probe is attempted
HORIZON_BREAKER_RESET_TIMEOUT=30000

# Analytics cache: maximum number of entries retained before the oldest are evicted
ANALYTICS_CACHE_MAX_ENTRIES=500

# Rate limiting. Defaults shown; both are overridable for load testing.
# Global limit, applied to every route.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
# Stricter limit, applied to sensitive lookups (accounts, payments, analytics, tips).
STRICT_RATE_LIMIT_MAX=20
STRICT_RATE_LIMIT_WINDOW_MS=60000

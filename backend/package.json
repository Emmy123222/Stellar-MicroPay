{
  "name": "stellar-micropay-backend",
  "version": "1.0.0",
  "description": "Backend API for Stellar MicroPay",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:turrets": "TURRETS_PORT=4100 nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest",
    "lint": "eslint src/**/*.js"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.1",
    "axios": "1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-rulesdir": "^0.2.2",
    "jest": "^30.5.1",
    "nodemon": "^3.1.2",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  },
  "overrides": {
    "toml": "^4.2.0"
  },
  "engines": {
    "node": "20.19.5"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "commonjs",
            "moduleResolution": "node",
            "esModuleInterop": true,
            "target": "ES2020",
            "resolveJsonModule": true
          },
          "diagnostics": false,
          "isolatedModules": true
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(@stellar|@exodus|uint8array-extras|@noble|@scure)/)"
    ],
    "moduleNameMapper": {
      "^uint8array-extras$": "<rootDir>/__mocks__/uint8array-extras.js",
      "^@exodus/bytes/base32\\.js$": "<rootDir>/__mocks__/exodus-bytes-base32.js"
    },
    "testPathIgnorePatterns": [
      "<rootDir>/__tests__/.*\\.ts$"
    ]
  }
}

# =============================================================================
# Stellar-MicroPay — Frontend (Next.js) environment variables
# Copy this file to `frontend/.env.local` and adjust the values per environment.
# Lines marked `# REQUIRED` must be set; everything else has a safe default.
#
# NOTE: only variables prefixed with `NEXT_PUBLIC_` are exposed to the browser.
# Treat all of them as public — never put secrets in a NEXT_PUBLIC_ variable.
# =============================================================================

# Stellar network the UI targets: "testnet" | "mainnet".
# REQUIRED. Keep this in sync with the backend's STELLAR_NETWORK.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Horizon API URL used for account data and transaction submission.
# Testnet: https://horizon-testnet.stellar.org
# Mainnet: https://horizon.stellar.org
# REQUIRED.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Horizon Friendbot URL used to fund new accounts on testnet only.
# (Optional — leave empty on mainnet.)
NEXT_PUBLIC_FRIENDBOT_URL=https://friendbot.stellar.org

# Deployed Soroban contract ID used to record tips / escrow operations.
# REQUIRED. Copy it from the contract deployment output, e.g.
#   CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
NEXT_PUBLIC_CONTRACT_ID=

# Base URL of the Stellar-MicroPay backend API.
# (Optional — defaults to http://localhost:4000 in development.)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Issuer account (G...) for the USDC asset used in the UI. Leave blank to use
# the network default testnet USDC issuer.
# (Optional.)
NEXT_PUBLIC_USDC_ISSUER=

# VAPID public key for Web Push notifications (PWA). Generate a keypair with:
#   npx web-push generate-vapid-keys
# REQUIRED only if you want push notifications enabled; the matching private
# key stays on the push server and is never exposed here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Anthropic API key used by the AI Payment Assistant API route. This runs on the
# server, so it is NOT exposed to the browser.
# REQUIRED if the AI Payment Assistant is enabled. Never commit the real value.
# Generate with: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

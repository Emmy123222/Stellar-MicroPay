# Stellar Network (testnet or mainnet)
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Horizon API URL
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban Contract ID (for recording tips)
NEXT_PUBLIC_CONTRACT_ID=

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# SEP-0006 anchor server for fiat on/off-ramp (Closes #1142)
NEXT_PUBLIC_ANCHOR_URL=https://testanchor.stellar.org

# Web Push VAPID public key (Closes #1143) — must match backend VAPID_PUBLIC_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Anthropic API Key for AI Payment Assistant
ANTHROPIC_API_KEY=your_anthropic_api_key_here
